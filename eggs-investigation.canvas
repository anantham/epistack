    { "id": "e10", "fromNode": "interpretation-map", "fromSide": "bottom", "toNode": "ai-context-questions", "toSide": "top", "label": "remaining high-VOI gaps" },
    { "id": "e11", "fromNode": "ai-context-questions", "fromSide": "right", "toNode": "h-rant", "toSide": "left", "label": "specific prompts" },
    { "id": "e12", "fromNode": "h-rant", "fromSide": "right", "toNode": "action-space", "toSide": "left", "label": "context + feasible options" },
    { "id": "e13", "fromNode": "action-space", "fromSide": "right", "toNode": "ai-filtered-graph", "toSide": "left", "label": "constraints" },
    { "id": "e14", "fromNode": "ai-filtered-graph", "fromSide": "bottom", "toNode": "personalization-guardrail", "toSide": "right", "label": "personalized lens" },
    { "id": "e15", "fromNode": "personalization-guardrail", "fromSide": "bottom", "toNode": "dashboard-human", "toSide": "top", "label": "broad + applicable search" },
    { "id": "e16", "fromNode": "dashboard-human", "fromSide": "right", "toNode": "orchestrator", "toSide": "left", "label": "steering + budgets" },
    { "id": "e17", "fromNode": "orchestrator", "fromSide": "bottom", "toNode": "research-agents", "toSide": "top", "label": "bounded briefs" },
